        client = razorpay.Client(
            auth=('rzp_test_klfWwvjaFXjXmC', 's9P7dwOwYckK352FfRJOXIRV')
        )
        payment = client.order.create({
            'amount': amount,
            'currency': order_currency,
            'payment_capture': '1'
        })

